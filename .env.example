# Copy this file to `.env` and fill in the values from the Supabase dashboard
# (Project Settings -> API). Both keys are safe to ship in the client: the anon
# key only grants what the Row Level Security policies in supabase-schema.sql
# allow. `.env` itself is gitignored so the project ref does not leak.
#
# Leave these blank to run fully offline — Pass & Play and Vs Computer work
# without Supabase; only login and online modes go dark.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK key (RevenueCat dashboard -> Project settings -> API
# keys). A `test_` key uses RevenueCat's Test Store and works in any build, web
# included. A `goog_` key uses Google Play Billing and only works in a build
# installed from Google Play. Blank: the shop opens, Buy says it is unavailable.
EXPO_PUBLIC_REVENUECAT_API_KEY=
# Only enable for preview builds using RevenueCat Test Store. Never production.
EXPO_PUBLIC_ALLOW_TEST_STORE=false
